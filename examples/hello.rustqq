// A quick tour of RUST++ v1.
let name = input("What is your name? ");
print "Hello, " + name + "!";

fn square(number) {
    return number * number;
}

let values = [1, 2, 3, 4, 5];
for (let i = 0; i < len(values); i = i + 1) {
    values[i] = square(values[i]);
}
print values;
print "There are " + str(len(values)) + " values.";
