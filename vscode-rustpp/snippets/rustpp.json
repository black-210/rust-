{
  "Print value": {
    "prefix": "print",
    "body": ["print ${1:value};"],
    "description": "Print a value"
  },
  "Let binding": {
    "prefix": "let",
    "body": ["let ${1:name} = ${2:value};"],
    "description": "Declare a variable"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "    ${2:// then}",
      "} else {",
      "    ${3:// otherwise}",
      "}"
    ],
    "description": "Conditional with an else branch"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    ${2:// loop body}",
      "}"
    ],
    "description": "Repeat while a condition is true"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:parameters}) {",
      "    ${3:// function body}",
      "    return ${4:value};",
      "}"
    ],
    "description": "Declare a function"
  },
  "Comment": {
    "prefix": "comment",
    "body": ["// ${1:comment}"],
    "description": "Insert a line comment"
  }
}
